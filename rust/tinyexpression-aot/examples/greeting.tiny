```rust:example.Greeting
use tinyexpression_rs::runtime::bindings::{BindingError, ClassBindings};

pub fn register(class: &mut ClassBindings) -> Result<(), BindingError> {
    class.bind::<(String,), String, _>("greet", |vars, (name,)| {
        Ok(format!("{}{}", vars.string("prefix").unwrap_or_default(), name))
    })
}
```
import example.Greeting#greet as greet;
external returning as string greet($name)
