[Unit]
Description=tinyexpression MCP server

[Service]
Type=simple
WorkingDirectory=/home/opa/tinyexpression
Environment=PORT=9237
EnvironmentFile=-/home/opa/volta-secrets/tinyexpression.env
ExecStart=/home/opa/tinyexpression/run.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
