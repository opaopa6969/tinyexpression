{
  "repository": {
    "type": "git",
    "url": "https://github.com/opaopa6969/tinyexpression.git"
  },
  "homepage": "https://unlaxer.org",
  "bugs": {
    "url": "https://github.com/opaopa6969/tinyexpression/issues"
  },
  "author": {
    "name": "unlaxer.org",
    "url": "https://unlaxer.org"
  },
  "name": "tinyexpression-p4-lsp",
  "displayName": "TinyExpression P4 LSP/DAP",
  "description": "Type-safe LSP/DAP for TinyExpression P4 grammar (UBNF-generated parser, sealed-interface AST, 6-backend parity probe)",
  "version": "0.2.33",
  "publisher": "opaopa6969",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "activationEvents": [
    "onLanguage:tinyexpressionP4",
    "onCommand:tinyExpressionP4Lsp.showServerOutput"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tinyExpressionP4Lsp.showServerOutput",
        "title": "TinyExpression P4 LSP: Show Server Output",
        "category": "TinyExpression P4"
      }
    ],
    "languages": [
      {
        "id": "tinyexpressionP4",
        "aliases": [
          "TinyExpression P4",
          "tinyexpressionp4"
        ],
        "extensions": [
          ".tinyexp",
          ".formulainfo"
        ],
        "filenames": [
          "default",
          "emergency",
          "formulaInfo.txt",
          "formula-info.txt"
        ],
        "filenamePatterns": [
          "*.default",
          "*.emergency"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tinyexpressionP4",
        "scopeName": "source.tinyexpression",
        "path": "./syntaxes/tinyexpression.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.java": "java"
        }
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "tinyexpressionP4",
        "scopes": {
          "keyword": [
            "keyword.control.tinyexpression"
          ],
          "variable": [
            "variable.other.readwrite.tinyexpression",
            "variable.other.tinyexpression"
          ],
          "function": [
            "entity.name.function.tinyexpression",
            "support.function.builtin.tinyexpression"
          ],
          "number": [
            "constant.numeric.tinyexpression"
          ],
          "string": [
            "string.quoted.single.tinyexpression",
            "string.quoted.double.tinyexpression"
          ],
          "operator": [
            "keyword.operator.tinyexpression",
            "punctuation.separator.tinyexpression"
          ],
          "comment": [
            "comment.line.double-slash.tinyexpression",
            "comment.block.tinyexpression"
          ]
        }
      }
    ],
    "debuggers": [
      {
        "type": "tinyexpressionP4",
        "label": "TinyExpression P4 Debug",
        "program": "./out/extension.js",
        "runtime": "node",
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to the TinyExpression source file to debug.",
                "default": "${file}"
              },
              "runtimeMode": {
                "type": "string",
                "enum": [
                  "metadata",
                  "javacode",
                  "legacy-astcreator",
                  "ast-evaluator",
                  "dsl-javacode",
                  "p4-ast",
                  "p4-dsl-javacode"
                ],
                "default": "metadata",
                "description": "Execution backend. metadata follows FormulaInfo executionBackend and defaults plain files to p4-ast."
              },
              "calculatorName": {
                "type": "string",
                "description": "FormulaInfo calculatorName to debug. The first formula is selected when omitted."
              },
              "allowJavaCodeBlocks": {
                "type": "boolean",
                "default": false,
                "description": "Explicitly allow embedded Java compilation/execution in this isolated debug-adapter process. Disabled by default because Java blocks execute arbitrary code."
              },
              "variables": {
                "type": "object",
                "description": "Typed variable values injected into CalculationContext and used by the selected backend, parity probe, Variables view, and Debug Console.",
                "additionalProperties": {
                  "type": [
                    "number",
                    "boolean",
                    "string"
                  ]
                }
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Pause on the first AST node before continuing.",
                "default": true
              },
              "steppingMode": {
                "type": "string",
                "enum": [
                  "ast",
                  "token"
                ],
                "default": "ast",
                "description": "Structural stepping model. AST mode does not silently fall back to token stepping."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "tinyexpressionP4",
            "request": "launch",
            "name": "Debug TinyExpression P4",
            "program": "${file}",
            "runtimeMode": "metadata",
            "steppingMode": "ast",
            "stopOnEntry": true
          },
          {
            "type": "tinyexpressionP4",
            "request": "launch",
            "name": "Debug TinyExpression P4 (with variables)",
            "program": "${file}",
            "runtimeMode": "metadata",
            "steppingMode": "ast",
            "stopOnEntry": true,
            "variables": {
              "score": 42,
              "inputName": "alice"
            }
          }
        ]
      }
    ],
    "configuration": {
      "type": "object",
      "title": "TinyExpression P4 LSP",
      "properties": {
        "tinyExpressionP4Lsp.server.javaPath": {
          "type": "string",
          "default": "java",
          "description": "Path to Java executable (Java 21+ required)."
        },
        "tinyExpressionP4Lsp.server.jarPath": {
          "type": "string",
          "default": "",
          "description": "Path to tinyexpression-p4-lsp-server.jar (leave empty to use bundled jar)."
        },
        "tinyExpressionP4Lsp.server.jvmArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra JVM arguments (e.g. -Xmx512m)."
        },
        "tinyExpressionP4Lsp.runtimeMode": {
          "type": "string",
          "enum": [
            "metadata",
            "javacode",
            "legacy-astcreator",
            "ast-evaluator",
            "dsl-javacode",
            "p4-ast",
            "p4-dsl-javacode"
          ],
          "default": "metadata",
          "description": "Execution backend for formula evaluation and DAP debug. metadata follows FormulaInfo executionBackend."
        },
        "tinyExpressionP4Lsp.fileExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".tinyexp",
            ".formulainfo"
          ],
          "description": "File extensions to watch for the TinyExpression P4 language (must match contributes.languages.extensions)."
        },
        "tinyExpressionP4Lsp.catalog.path": {
          "type": "string",
          "default": "",
          "description": "Path (or OS path-separator-delimited list of paths) to .tecatalog files or directories. When empty, the bundled catalog under config/ is used if present."
        },
        "tinyExpressionP4Lsp.catalog.useBundledDefault": {
          "type": "boolean",
          "default": true,
          "description": "When true and catalog.path is empty, automatically include any .tecatalog files bundled in the extension's config/ directory."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "bundle": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --platform=node --format=cjs --sourcemap",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx --yes @vscode/vsce package --no-dependencies"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.26.0",
    "esbuild": "^0.27.3",
    "typescript": "^5.4.5"
  }
}
