{
  "name": "tinyexpression-playground",
  "private": true,
  "version": "0.1.0",
  "description": "Static tinyexpression playground: CodeMirror 6 + tinyexpression.wasm + the language catalog (issue #201)",
  "type": "module",
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "validator": "node scripts/build-validator.mjs",
    "predev": "node scripts/build-validator.mjs",
    "dev": "vite",
    "prebuild": "node scripts/build-validator.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "parity": "node scripts/parity-smoke.mjs",
    "check": "node scripts/build-validator.mjs && node scripts/check.mjs",
    "roundtrip": "node scripts/build-validator.mjs && node scripts/catalog-roundtrip.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "codemirror": "^6.0.2"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "vite": "^8.3.1"
  }
}
